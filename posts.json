---
---
[
{% for post in site.posts %}
  {
    "slug": {{ post.url | jsonify }},
    "title": {{ post.title | jsonify }},
    "section": {{ post.categories | first | jsonify }},
    "date": "{{ post.date | date: "%Y-%m-%d" }}",
    "content": {{ post.content | strip_html | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]